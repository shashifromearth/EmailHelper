# EmailHelper configuration. Copy to .env and adjust. Never commit .env.
# Full reference: documents/CONFIGURATION.md

# ---------------------------------------------------------------- core
EH_BIND_ADDR=127.0.0.1:7800
# Shared secret for the Thunderbird extension and dashboard (32+ random chars).
# Leave empty to auto-generate into data/api-token.txt on first start.
EH_API_TOKEN=
EH_DATA_DIR=./data
# EH_DATABASE_PATH=./data/emailhelper.db
EH_KNOWLEDGE_DIR=./knowledge
EH_LOG_FORMAT=json
RUST_LOG=info
EH_MAX_CONCURRENCY=10
EH_MAX_BODY_BYTES=262144
EH_MAX_EMAIL_TEXT_BYTES=65536
EH_MAX_ATTACHMENT_BYTES=26214400
EH_WORKFLOW_VERSION=1
EH_MAX_RETRIES=3
# Mail older than this (hours) is recorded but not sent to the LLM; 0 = no limit.
EH_MAX_EMAIL_AGE_HOURS=72

# Senders that never enter the system (addresses and/or domains, ; separated)
# EH_EXCLUDED_SENDERS=hdfcbank.com;icicibank.com;alerts@paytm.com
# Share of real drafts scored by the LLM judge in the background
EVAL_LIVE_SAMPLE=0.25

# ---------------------------------------------------------------- Knowledge service (RAG)
KNOWLEDGE_SERVICE_ADDR=127.0.0.1:7820
KNOWLEDGE_SERVICE_URL=http://127.0.0.1:7820
# KNOWLEDGE_SERVICE_TOKEN defaults to EH_API_TOKEN
RAG_GEMINI_MODEL=gemini-embedding-001
RAG_LOCAL_MODEL=nomic-embed-text
RAG_ETL_CHECK_HOURS=6

# ---------------------------------------------------------------- LLM
# LOCAL | REMOTE_GROQ | REMOTE_GEMINI | REMOTE_OPENAI | REMOTE_ANTHROPIC | MOCK
# Cloud modes send email text to that provider; private.json values never leave this machine.
# Remote modes silently fall back to LOCAL when the API key is empty.
MODEL_MODE=LOCAL
OLLAMA_BASE_URL=http://127.0.0.1:11434
# qwen2.5:3b (low RAM) | qwen2.5:7b | llama3 | mistral
OLLAMA_MODEL=qwen2.5:7b
# Context window requested from Ollama (its default is 4096 tokens).
OLLAMA_NUM_CTX=8192
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Groq (OpenAI-compatible, very fast)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
LLM_TIMEOUT_SECS=90
LLM_FALLBACK_TO_LOCAL=true
# In a cloud mode, try the other cloud providers that have a key before Ollama
LLM_FALLBACK_CLOUD=true
# LLM second-opinion review of drafts: auto (on for cloud, off for local) | true | false
LLM_REVIEW=auto
# Concurrent model calls; 0 = auto (1 for local Ollama, 4 for cloud)
LLM_MAX_PARALLEL=0
OLLAMA_KEEP_ALIVE=24h

# ---------------------------------------------------------------- Telegram
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# One bot serves every person; list chat ids with: emailhelper telegram-chats

# ---------------------------------------------------------------- Job application agent
JOB_AGENT_ENABLED=false
# review (fill, then ask on Telegram before submitting) | auto | dry_run
JOB_SUBMIT_MODE=review
JOB_AUTO_APPLY_THRESHOLD=80
JOB_REVIEW_THRESHOLD=60
JOB_RESUME_PATH=./knowledge/resume.pdf
JOB_MAX_ATTEMPTS=3
# Daily Telegram digest of platform-only jobs (LinkedIn/Naukri) to apply to yourself
JOB_DIGEST_TIME=19:00
JOB_DIGEST_MAX=15
BROWSER_WORKER_URL=http://127.0.0.1:7801
BROWSER_WORKER_TOKEN=
BROWSER_WORKER_TIMEOUT_SECS=180

# Browser worker (Node/Playwright) settings
BROWSER_WORKER_HOST=127.0.0.1
BROWSER_WORKER_PORT=7801
BROWSER_PROFILE_DIR=./data/browser-profile
BROWSER_HEADLESS=true
# Use an installed browser instead of Playwright's Chromium: msedge | chrome (empty = bundled)
BROWSER_CHANNEL=
BROWSER_SCREENSHOT_DIR=./data/screenshots
BROWSER_ALLOWED_UPLOAD_DIRS=./knowledge;./data

# ---------------------------------------------------------------- Job-link queue (job-links service)
# true = queue every job link from mail for the Chrome extension instead of
# applying with the browser worker (job emails still need JOB_AGENT_ENABLED).
JOB_LINKS_ENABLED=false
JOB_LINKS_URL=http://127.0.0.1:7810
# Shared secret, 16+ random chars; the service will not start without it.
JOB_LINKS_TOKEN=
JOB_LINKS_PORT=7810
JOB_LINKS_SNAPSHOT=./data/job-links.json
JOB_LINKS_SNAPSHOT_SECS=5
JOB_LINKS_LEASE_SECS=900

# ---------------------------------------------------------------- Research agent
RESEARCH_ENABLED=false
# Discovery runs once a day; checked at startup and every N hours
RESEARCH_CHECK_INTERVAL_HOURS=4
# SEARXNG_URL=http://127.0.0.1:8888   (enable when SearXNG runs, e.g. docker compose --profile research)
SEARXNG_URL=
RESEARCH_SEARCH_TERMS=AI Architect;Lead AI Engineer;Staff AI Engineer;Rust Engineer;Remote AI Jobs;India AI Jobs;GenAI Architect
RESEARCH_RSS_FEEDS=
# Public job-board slugs, e.g. RESEARCH_GREENHOUSE_BOARDS=anthropic;databricks
RESEARCH_GREENHOUSE_BOARDS=
RESEARCH_LEVER_BOARDS=
RESEARCH_ASHBY_BOARDS=
RESEARCH_CAREER_PAGES=
RESEARCH_MAX_RESULTS_PER_QUERY=20
RESEARCH_SUMMARY_TOP_N=10
# Start applications for discovered jobs (needs JOB_AGENT_ENABLED). Off by default.
RESEARCH_AUTO_APPLY=false
# Remote boards + filters for daily discovery
RESEARCH_REMOTE_BOARDS=remotive;remoteok;himalayas;jobicy;weworkremotely
RESEARCH_MAX_AGE_HOURS=25
# false = on-site/hybrid jobs are kept too when in your country or offering visa sponsorship/relocation
RESEARCH_REQUIRE_REMOTE=false
# Hard filter on role type; none = any (full-time included)
RESEARCH_WORK_TYPES=none
# Ranked first (with remote): each earns RESEARCH_PRIORITY_BOOST points in the ranking
RESEARCH_PREFERRED_WORK_TYPES=contract;freelance;consultant
RESEARCH_PRIORITY_BOOST=10
RESEARCH_TECH_STACK=python;c#;.net;java;rust;go;genai;agentic ai
# RESEARCH_APPLICANT_COUNTRY=India

# Job APIs and search APIs read once a day. A source without its key is skipped (one log line).
RESEARCH_SOURCES=adzuna;jooble;careerjet;arbeitnow;themuse;google_cse;brave
# Keywords the job APIs are queried with (one request per keyword and country/location, rotated daily)
RESEARCH_API_QUERIES=python developer;python architect;.net developer;c# developer;java developer;java architect;golang developer;rust developer;generative ai engineer;agentic ai;genai architect;solution architect;engineering manager
# Request budget per run: all API sources together, and each source
RESEARCH_API_MAX_REQUESTS=250
RESEARCH_API_MAX_REQUESTS_PER_SOURCE=40
# Pause between requests to one API; empty = each API's own (Adzuna 2.5 s, Brave 1.1 s, others 0.5-1 s)
RESEARCH_API_DELAY_MS=
# Adzuna (https://developer.adzuna.com) - countries: in us gb de sg nl au ca fr at be ch es it mx nz pl br za
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRIES=in;us;gb;de;sg;nl
# Jooble (https://jooble.org/api/about)
JOOBLE_API_KEY=
JOOBLE_LOCATIONS=Remote;India
# Careerjet (https://www.careerjet.com/partners/api) - your affiliate id and public IP
CAREERJET_AFFID=
CAREERJET_LOCALES=en_IN;en_AE;en_SG;en_GB;en_US
CAREERJET_USER_IP=127.0.0.1
# Arbeitnow and The Muse need no key (THEMUSE_API_KEY only raises the rate limit)
ARBEITNOW_PAGES=3
THEMUSE_PAGES=5
THEMUSE_API_KEY=
# Search APIs: postings on LinkedIn, Glassdoor, Naukri... found via site: queries (never scraped).
# Applied later with the browser extension, not by the agent.
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
BRAVE_SEARCH_KEY=
RESEARCH_SEARCH_ROLES=developer;senior engineer;architect;lead;engineering manager
RESEARCH_SEARCH_STACKS=python;.net;java;golang;rust;generative ai;agentic ai
RESEARCH_SEARCH_SITES=linkedin;glassdoor;naukri;wellfound;indeed;instahyre;hirist;foundit;iimjobs;upwork;freelancer;arc;dice;remoteco

# Recruiter discovery (drafts only; nothing is ever sent)
RECRUITER_DISCOVERY_ENABLED=false
# Uses YOUR logged-in LinkedIn session in the browser worker profile. Review
# LinkedIn's terms before enabling; searches are capped per day.
RECRUITER_LINKEDIN_ENABLED=false
RECRUITER_DAILY_LIMIT=20
