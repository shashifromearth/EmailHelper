{
  "manifest_version": 2,
  "name": "EmailHelper",
  "description": "Sends new mail to the local EmailHelper assistant and saves the AI-generated replies as Thunderbird drafts. Never sends mail.",
  "version": "1.0.0",
  "author": "EmailHelper",
  "browser_specific_settings": {
    "gecko": {
      "id": "emailhelper@local",
      "strict_min_version": "115.0"
    }
  },
  "icons": {
    "16": "icons/icon.svg",
    "32": "icons/icon.svg",
    "48": "icons/icon.svg",
    "64": "icons/icon.svg",
    "128": "icons/icon.svg"
  },
  "background": {
    "page": "background.html"
  },
  "browser_action": {
    "default_title": "EmailHelper",
    "default_icon": "icons/icon.svg",
    "default_popup": "popup/popup.html",
    "default_area": "maintoolbar"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "messagesRead",
    "accountsRead",
    "compose",
    "compose.save",
    "storage",
    "notifications",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ]
}
